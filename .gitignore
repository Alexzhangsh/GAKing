# ============================================================
# GAKing 项目根 .gitignore（参考 companysite_admin 配置风格）
# 覆盖：Python backend + Vue admin + 微信小程序 + 部署脚本
# ============================================================

# ── 依赖目录 ──
node_modules/
.pnp
.pnp.js
.venv/
.venv_new/
venv/
ENV/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# ── 构建产物 ──
dist/
build/
*.js.map
.tsbuildinfo

# ── 环境变量文件（含密钥，禁止推送） ──
.env
.env.*
!.env.example
*.env

# ── SSL 证书与私钥（禁止推送） ──
backend/ssl/
*.pem
*.key
*.crt
*.cert

# ── Redis 持久化与配置（含密码风险） ──
dump.rdb
*.rdb
backend/redis/

# ── IDE / 编辑器 ──
.idea/
.vscode/
.trae/
*.swp
*.swo
*~

# ── 操作系统 ──
.DS_Store
Thumbs.db

# ── 日志 ──
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── 测试与覆盖率 ──
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
*.test.js
*.spec.js

# ── 数据库迁移敏感配置 ──
alembic.ini
backend/alembic.ini

# ── 上传文件与临时目录 ──
backend/static/uploads/*
backend/tmp/*
uploads/
*.tmp
*.temp
*.old
*.bak

# ── 私钥与凭证 ──
credentials.json
secrets.json
*.p12
*.jks

# ── 脚本日志与本地配置（保留 .template / .sh / .py） ──
scripts/*.log
scripts/cdn_cert_alert_config.sh
scripts/cdn_cert_alert_config.local

# ── 压缩包 ──
*.zip
*.tar.gz
*.tar
.deploy_backup/
