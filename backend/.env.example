# ============================================
# 金角大王CPS返利小程序 - 环境变量配置模板
# 用法：复制为 .env.development / .env.test / .env.production 后填写
# 禁止直接使用本文件运行，所有 {{xxx}} 占位符必须替换为真实值
# 部署前校验：bash scripts/pre_deploy_check.sh
# ============================================

# ── 环境标识 ──
# 可选值：development / test / production
ENVIRONMENT=development
PORT=3001

# ── MySQL 配置 ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=gaking
TIMEZONE=+08:00

# ── Redis 配置 ──
# 生产环境 Docker 部署时，REDIS_HOST 由 docker-compose 覆盖为 "redis"（容器服务名）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── JWT 鉴权配置 ──
# 生产环境红线：长度必须≥64位，禁止与 dev/test 环境共用
JWT_SECRET=CHANGE_ME_TO_A_STRONG_SECRET_AT_LEAST_64_CHARS_LONG
JWT_EXPIRES_IN=3600

# ── 跨域白名单 ──
# 生产环境红线：禁止使用通配符 *，多个域名逗号分隔
CORS_ORIGINS=http://localhost:5173

# ── 本地文件存储 ──
LOCAL_UPLOAD_BASE_DIR=./static/uploads
LOCAL_STATIC_PREFIX=/static/uploads
UPLOAD_TEMP_DIR=./tmp

# ── OBS 对象存储 + CDN ──
# 华为云 OBS 配置，用于商品图片、用户头像等文件存储
CDN_IMG_BASE_URL=https://your-cdn-domain.com
OBS_PROJECT_PREFIX=prod
OBS_ACCESS_KEY_ID=
OBS_SECRET_ACCESS_KEY=
OBS_ENDPOINT=https://obs.cn-east-3.myhuaweicloud.com
OBS_BUCKET_NAME=goldalicorn

# ── 第三方 CPS 渠道密钥 ──
# 喵有券（必填）：https://www.myq.to 后台获取
MIAO_QUAN_TOKEN=
MIAO_QUAN_TBNAME=
MIAO_QUAN_PID=
# 大淘客（可选）：https://www.dataoke.com 后台获取，留空禁用该渠道
DATAOK_APPID=
DATAOK_APPKEY=
# 订单侠（可选）：https://www.orderx.cn 后台获取，留空禁用该渠道
ORDERX_TOKEN=

# ── 微信小程序配置（C端 OAuth 登录） ──
# 开发环境留空 → 自动走 mock 登录兜底
# 生产环境填入真实 AppID/Secret
WX_MINI_APPID=
WX_MINI_SECRET=

# ── 风控业务参数 ──
RISK_HOLD_RATIO=0.20
SETTLE_COOL_DAY=30
SETTLE_DELAY_DAY=7

# ── 限流阈值配置 ──
RATE_LIMIT_NORMAL=60
RATE_LIMIT_SEARCH=20
RATE_LIMIT_TRANSFORM=100
RATE_LIMIT_PAY=10
DATAOK_SEARCH_LIMIT=100
DATAOK_TRANSFORM_LIMIT=300

# ── 定时任务配置 ──
SCHEDULER_ENABLE=true
SHARD_TOTAL=1
SHARD_INDEX=0
SCHEDULER_CRON_SYNC_CONFIG=0 * * * *
SCHEDULER_CRON_SYNC_ORDER_STATUS=*/5 * * * *
SCHEDULER_CRON_CLEAN_EXPIRED_DATA=0 3 * * *
SCHEDULER_CRON_UPDATE_CHANNEL_MAPPING=0 2 * * *
SCHEDULER_RETRY_MAX=3

