# ============================================
# 空白基准模板，仅用于拷贝生成环境配置，禁止直接运行
# ============================================
ENVIRONMENT=
PORT=3001

# MySQL配置
DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
TIMEZONE=+08:00

# Redis配置
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT鉴权配置
JWT_SECRET=
JWT_EXPIRES_IN=

# 跨域白名单
CORS_ORIGINS=

# 本地文件存储
LOCAL_UPLOAD_BASE_DIR=./static/uploads
LOCAL_STATIC_PREFIX=/static/uploads
UPLOAD_TEMP_DIR=

# OBS对象存储+CDN
CDN_IMG_BASE_URL=
OBS_PROJECT_PREFIX=prod
OBS_ACCESS_KEY_ID=
OBS_SECRET_ACCESS_KEY=
OBS_ENDPOINT=https://obs.cn-east-3.myhuaweicloud.com
OBS_BUCKET_NAME=

# 第三方CPS密钥
MIAO_QUAN_TOKEN=
DATAOK_APPID=
DATAOK_APPKEY=
ORDERX_TOKEN=

# 风控业务参数
RISK_HOLD_RATIO=
SETTLE_COOL_DAY=
SETTLE_DELAY_DAY=

# 限流阈值配置
RATE_LIMIT_NORMAL=60
RATE_LIMIT_SEARCH=20
RATE_LIMIT_TRANSFORM=100
RATE_LIMIT_PAY=10
DATAOK_SEARCH_LIMIT=100
DATAOK_TRANSFORM_LIMIT=300

# 定时任务配置
SCHEDULER_ENABLE=true
SHARD_TOTAL=1
SHARD_INDEX=0
SCHEDULER_CRON_SYNC_CONFIG=0 * * * *
SCHEDULER_CRON_SYNC_ORDER_STATUS=*/5 * * * *
SCHEDULER_CRON_CLEAN_EXPIRED_DATA=0 3 * * *
SCHEDULER_CRON_UPDATE_CHANNEL_MAPPING=0 2 * * *
SCHEDULER_RETRY_MAX=3