# Redis 容器密码（仅容器内部网络，不对外暴露端口）
# 生成强密码：openssl rand -base64 24
# 该密码同时被 docker-compose 注入到 backend 容器的 REDIS_PASSWORD 环境变量
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD